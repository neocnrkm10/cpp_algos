/*
Accesing all elements of stack using top and pop methods


*/

#include<iostream>
using namespace std;
#include<stack>


int main(){
	stack<int> s;
	int n;
	int num;
	cout<<"Enter number of elements:";
	cin>>num;
	int i;
	for(i=0;i<num;i++){
		cout<<"Enter element stack["<<i+1<<"]:";
		cin>>n;
		s.push(n);
		
		
		
		}
		while(!s.empty()){
			
			cout<<s.top()<<"\n";
			s.pop();
			
			
			}
	
	return 0;
	
	
	}
